{
    "extends": "tsconfig/react-client-library.json",
    "include": [
        "."
    ],
    "exclude": [
        "dist",
        "build",
        "node_modules"
    ],
    "compilerOptions": {
        "paths": {
            "@components/*": [
                "./src/components/*"
            ],
            "@hooks/*": [
                "./src/hooks/*"
            ],
            "@state/*": [
                "./src/state/*"
            ],
            "@helpers/*": [
                "./src/helpers/*"
            ]
        }
    }
}