{
  "extends": "tsconfig/base.json",
  "include": [
    "src",
    "../../lib/client-components/frontend-util/src/use-debounced-value.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "types": [
      "vite-plugin-pwa/client"
    ],
    "paths": {
      "@layout/*": [
        "./src/layout/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@workers/*": [
        "./src/workers/*"
      ]
    }
  }
}