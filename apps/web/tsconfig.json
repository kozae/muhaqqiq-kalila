{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "src/components/server/*"
      ],
      "@client/*": [
        "src/components/client/*"
      ],
      "@icons/*": [
        "src/components/icons/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ],
    }
  }
}