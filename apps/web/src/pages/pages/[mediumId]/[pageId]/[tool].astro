---
import ToolLayout from "@layouts/PagesInnerLayout.astro";
import Info from "@client/pages/Info";
import Layout from "@client/pages/Layout";

const { pageId, mediumId, tool } = Astro.params;
---

<ToolLayout pageId={pageId} mediumId={mediumId!} tool={tool}>
  <div class="animate-fade-in w-full grow scale-90 rounded bg-white opacity-0">
    {tool === "info" && <Info pageId={pageId!} client:only />}
    {tool === "layout" && <Layout pageId={pageId!} client:only />}
    {!["info", "layout"].includes(tool!) && tool}
  </div>
</ToolLayout>
