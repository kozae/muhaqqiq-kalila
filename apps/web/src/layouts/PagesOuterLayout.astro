---
import SiteLayout from "./SiteLayout.astro";
import Paginator from "@components/Paginator.astro";
import { getEntry } from "astro:content";
import lodash from "lodash";
import TableCellsIcon from "@icons/TableCellsIcon.svelte";
import GoToButton from "@client/pages/GoToButton.svelte";
interface Props {
  mediumId: string;
  pageId?: string;
  tool?: string;
  transitions?: boolean;
}

const { mediumId, pageId, tool = "", transitions = false } = Astro.props;

const {
  data: { siglum, pages },
} = (await getEntry("mediaPages", mediumId))!;
const sortedPages = lodash.sortBy(pages, "number");
const currentPageIndex = sortedPages.findIndex((p) => p.id === pageId);
const ids = sortedPages.map((p) => p!.id) ?? [];
---

<SiteLayout title={`Edit ${siglum} Pages`} transitions={transitions}>
  <nav
    class="bg-secondary-50 fixed left-0 top-0 z-10 flex h-full w-[80px] flex-col items-center"
  >
    <a href="/">
      <img class="h-auto w-[70px] p-1" src="/logo_512.png" alt="" />
    </a>

    <a
      href={`/pages/${mediumId}/`}
      class="hover:bg-secondary-200 text-primary-500 focus-visible:outline-primary-600 mt-1 hidden items-center gap-x-1.5 rounded-md px-2.5 py-1.5 text-sm font-semibold shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 sm:inline-flex sm:flex-col"
    >
      <TableCellsIcon className="-ml-0.5 h-5 w-5" aria-hidden="true" />
       Summary
    </a>

    <div transition:persist>
      <GoToButton
        ids={ids}
        lastPage={sortedPages.length}
        mediumId={mediumId}
        client:load
      />
    </div>

    <Paginator
      pages={pages.length}
      current={currentPageIndex}
      baseHref={`/pages/${mediumId}/`}
      hrefSuffix={tool}
      ids={ids}
    />
  </nav>
  <main
    class="flex flex-col w-[calc(100%-80px)] grow rounded bg-white p-1 ml-[80px]"
  >
    <slot />
  </main>
</SiteLayout>
