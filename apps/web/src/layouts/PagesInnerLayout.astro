---
import ToolNav from "@components/PagesLayoutComponents/ToolNav.astro";
import PagesOuterLayout from "./PagesOuterLayout.astro";
import StateControls from "@client/pages/StateControls";
import FacsimileSpace from "@client/pages/Facsimile";
interface Props {
  mediumId: string;
  pageId?: string;
  tool?: string;
}

const { mediumId, pageId, tool = "" } = Astro.props;
---

<PagesOuterLayout mediumId={mediumId} pageId={pageId} tool={tool} transitions>
  <div class="flex w-full items-center">
    <div
      class="h-[80px] w-1/2"
      transition:persist={pageId}
      transition:animate="fade"
    >
      <StateControls client:only="svelte" />
    </div>
    <ToolNav tool={tool} mediumId={mediumId} pageId={pageId ?? ""} />
  </div>
  <div class="ml-0 flex w-full">
    {
      tool !== "segmentation" && (
        <div class="w-1/2 h-[calc(100vh-90px)] flex justify-center">
          <FacsimileSpace id={pageId!} client:only="svelte" />
        </div>
      )
    }
    <slot />
  </div>
</PagesOuterLayout>
