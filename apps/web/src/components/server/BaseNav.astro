      </div>
      <div class="h-content w-content hidden lg:block">
        <a href="/">
          <img class="h-[35px] w-auto" src="/logo_512.png" alt="" />
        </a>
      </div>
    </div>
  </div>
  <slot />
  <TopNav client:only />
</div>
